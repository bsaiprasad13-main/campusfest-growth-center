# AI copilot. Set at least one key. Providers are tried in LLM_PROVIDERS order (any configured
# provider left out is tried last); small models such as gpt-oss-20b are always tried last.
LLM_PROVIDERS=groq,backup,gemini

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Google Gemini (free backup, no card): https://aistudio.google.com/apikey
# Each model has its own free daily quota; the Flash-Lite models allow the most requests.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional extra provider: any OpenAI-compatible host (not needed for the free setup).
BACKUP_API_KEY=
BACKUP_BASE_URL=
BACKUP_MODELS=

# Optional: durable storage. Without these, edits are saved as JSON files in data/store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
