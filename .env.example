# AI copilot. Set at least one key. Providers are tried in LLM_PROVIDERS order; within a
# provider, models are tried left to right when one is busy or out of quota.
LLM_PROVIDERS=groq,gemini

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Google Gemini (optional backup): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite

# Optional: durable storage. Without these, edits are saved as JSON files in data/store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
